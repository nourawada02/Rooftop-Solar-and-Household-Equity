# Copy this file to .env and change the passwords. Local development only.
POSTGRES_USER=solar
POSTGRES_PASSWORD=change_me
POSTGRES_DB=solar_equity
MONGO_INITDB_ROOT_USERNAME=solar
MONGO_INITDB_ROOT_PASSWORD=change_me

# Ports on this computer. MongoDB uses 27018 by default so it cannot be confused with
# a MongoDB already installed on the computer (which would use 27017).
POSTGRES_PORT=5432
MONGO_PORT=27018
